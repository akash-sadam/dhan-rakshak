# ==============================================================================
# Dhan-Rakshak Environment Configuration
# ==============================================================================

# 1. Gnani.ai API Key (Obtain from https://vachana.ai or https://developer.gnani.ai)
# Replace 'gnani_demo_key_77a94f1c' with your actual key from the challenge portal / email
GNANI_API_KEY=gnani_demo_key_77a94f1c

# 2. Gnani Platform Endpoints (Defaults to official vachana.ai gateway)
GNANI_BASE_URL=https://api.vachana.ai
PRISMA_STT_URL=https://api.vachana.ai/api/v1/stt/inference
EVON_BASE_URL=https://api.vachana.ai/api/v1/chat/completions
TIMBRE_TTS_URL=https://api.vachana.ai/api/v1/tts/inference

# 3. Emergency Guardian Contact Details (Shown in the HUD & WhatsApp SOS Alert)
EMERGENCY_CONTACT_NAME="Akash (Son)"
EMERGENCY_CONTACT_PHONE="+91 98480 22338"

# Optional: Webhook endpoint for live SMS/WhatsApp gateway (e.g. Twilio / Gupshup / Make.com)
# EMERGENCY_WEBHOOK_URL=https://your-webhook-endpoint.com/api/sos
